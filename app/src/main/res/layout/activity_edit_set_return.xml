<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="cn.mhook.activity.editcfg.EditSetReturn">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/className"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="类名"
                    app:met_clearButton="true"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelText="类名"
                    app:met_helperText="例-Lcom/abc/ab; com.abc.ab" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/methodName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="方法名"
                    app:met_clearButton="true"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelText="方法名"
                    app:met_helperText="例-open isXXX" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/paramsName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="参数"
                    app:met_clearButton="true"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelText="参数"
                    app:met_helperText="例-(Lxx/xx;Lyy/yy;) xx.xx,yy.yy" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/returnType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="返回值类型"
                    app:met_clearButton="true"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelText="返回值类型"
                    app:met_helperText="例-Z I " />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/returnData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="返回值"
                    app:met_clearButton="true"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelText="返回值"
                    app:met_helperText="例-true 1" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/success"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_margin="60dp"
                    app:cardBackgroundColor="@color/blue">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检查"
                            android:textColor="@color/white"
                            android:textSize="16dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/save"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="60dp"
                    android:layout_marginRight="60dp"
                    android:layout_marginTop="-40dp"
                    app:cardBackgroundColor="@color/blue"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="保存"
                            android:textColor="@color/white"
                            android:textSize="16dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>


            </LinearLayout>
        </ScrollView>

    </androidx.cardview.widget.CardView>
</LinearLayout>
