<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="5dp"
        android:id="@+id/cfgInfoItem"
        android:focusable="true"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical"
            android:paddingLeft="5dp"
            android:paddingRight="5dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/appName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SuperHook"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/ver"
                    android:layout_width="wrap_content"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_height="wrap_content"
                    android:text="1.4"
                    android:layout_toRightOf="@id/appName"
                    android:textSize="16dp"
                    android:textColor="@color/qmui_config_color_75_pure_black"
                    android:layout_marginLeft="10dp"/>


                <LinearLayout
                    android:id="@+id/enableLayout"
                    android:layout_alignParentRight="true"
                    android:layout_alignBottom="@+id/ver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@color/app_color_theme_2"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/enableTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已启用"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="14dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/pkg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cn.superhook.app"
                    android:layout_below="@id/appName"
                    android:layout_marginTop="3dp"
                    android:textSize="14dp"
                    android:textColor="@color/qmui_config_color_75_pure_black"/>

                <TextView
                    android:id="@+id/detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去除更新提示,解锁会员功能"
                    android:layout_below="@+id/pkg"
                    android:layout_marginTop="3dp"
                    android:textSize="14dp"
                    android:textColor="@color/qmui_config_color_75_pure_black"/>

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2019-12-12 12:21:21"
                    android:layout_marginTop="3dp"
                    android:layout_alignParentRight="true"
                    android:layout_below="@id/author"
                    android:layout_marginRight="5dp"/>

                <TextView
                    android:id="@+id/author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MT-咸鱼"
                    android:layout_below="@id/detail"
                    android:layout_marginRight="5dp"
                    android:layout_alignParentRight="true"/>

                <LinearLayout
                    android:id="@+id/num_backgroud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignBottom="@id/time"
                    android:layout_marginBottom="3dp"
                    android:background="@color/green"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="网络导入"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="14dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/errLayout"
                    android:layout_toRightOf="@+id/num_backgroud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignBottom="@id/time"
                    android:layout_marginBottom="3dp"
                    android:layout_marginLeft="5dp"
                    android:background="@color/app_color_theme_2"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/err"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 1 "
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="14dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"/>
                </LinearLayout>
                <com.nightonke.boommenu.BoomMenuButton
                    android:id="@+id/bmb2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:bmb_buttonEnum="ham"
                    app:bmb_piecePlaceEnum="piecePlace_ham_5"
                    app:bmb_buttonPlaceEnum="buttonPlace_ham_5"
                    app:bmb_inList="true"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>