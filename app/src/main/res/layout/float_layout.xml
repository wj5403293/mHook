<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="340dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:padding="5dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/reduce"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/app_color_theme_9"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/min"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/contentViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tabSegment"
        android:layout_above="@+id/bar"
        android:background="@color/qmui_config_color_pure_black"/>
    <com.qmuiteam.qmui.widget.tab.QMUITabSegment2
        android:id="@+id/tabSegment"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        app:qmui_bottomDividerHeight="0px"
        android:background="@color/qmui_config_color_pure_black">
    </com.qmuiteam.qmui.widget.tab.QMUITabSegment2>



</RelativeLayout>